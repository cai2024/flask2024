<div class="row">
    <div class="col-md-12">
        <div class="border p-3 mb-4 box-fixed-height">
            <h2 class="h5">步骤按钮</h2>
            <div class="row">
                {% for category, buttons in available_steps.items() %}
                    <div class="col-md-3 mb-3">
                        <div class="card">
                            <div class="card-header">{{ category }}</div>
                            <div class="card-body">
                                {% for button in buttons %}
                                    <button class="btn btn-primary btn-block mb-2" 
                                        id="btn-{{ category }}-{{ button }}" 
                                        onclick="addStep('{{ button }}')">{{ button }}</button>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="border p-3 box-fixed-height">
            <h2 class="h5">展示参数</h2>
            <div id="outputArea"></div>
        </div>
    </div>
</div>


<script>
var available_steps = {{ available_steps | tojson }};
var raw_myOptions =  "raw.fq.gz";
var fq_type = "pair";
var temp_options = {};

var task_id="{{task_id}}";
let steps = [];

let isInitialized = false;
let raw_mode = "pair";
function addStep(type) {
    if (!isInitialized) {
        // 仅在第一次调用函数时执行以下初始化代码
        temp_options["fq"] = [];
        temp_options["fq1"] = [];
        temp_options["fq2"] = [];
        temp_options["bam"] = [];
        temp_options["bed"] = [];
        temp_options["other"] = [];
        temp_options["all"] = [];

        if (fq_type === "pair" && raw_myOptions[0] === "raw.fq.gz") {
            temp_options["fq1"] = ["raw_1.fq.gz"];
            temp_options["fq2"] = ["raw_2.fq.gz"];
            temp_options["all"] = ["raw_1.fq.gz", "raw_2.fq.gz"];
        } else if (fq_type === "single" && raw_myOptions[0] === "raw.fq.gz") {
            temp_options["fq"] = ["raw.fq.gz"];
            temp_options["all"] = ["raw.fq.gz"];
        } else {
            temp_options["bam"] = ["raw.bam"];
            temp_options["all"] = ["raw.bam"];
        }
        raw_mode = fq_type;

        isInitialized = true;  // 设置标志变量为 true，表示初始化已完成
    }
    $('#selected-steps').append(`<li class="list-group-item step-item" id="step-${steps.length}">${type}</li>`);
    $('#selected-steps').disableSelection();
    $('#selected-steps').sortable({update: function(event, ui) {
        steps = $('#selected-steps').children().map(function() {
            return steps.find(step => step.id === parseInt(this.id.replace('step-', ''))); }).get();} });
    steps.push({ id: steps.length, type: type, select_option: {}, params:'', mode: fq_type, raw_type: raw_myOptions[0], select_index:{}});
}


function updateSelection() {
    // 获取文件类型的选择
    var fileType = document.querySelector('input[name="fileType"]:checked').value;
    // 获取fastq类型的选择
    var fqType = document.querySelector('input[name="fqType"]:checked').value;
    raw_myOptions=[fileType]
    fq_type=fqType

    // 在控制台打印选择结果（可以替换为将数据发送到服务器或其他操作）
    console.log("Selected file type: " + raw_myOptions[0]);
    console.log("Selected fq type: " + fq_type);
}

window.onload = function() {
    // 初始化默认选择
    updateSelection();
};


</script>

